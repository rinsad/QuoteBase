{
  "name": "QuoteBase - Pending Approval Slack Alerts",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -40
      ]
    },
    {
      "parameters": {
        "url": "={{$env.SUPABASE_URL + '/rest/v1/quotes'}}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "id,quote_number,status,total,created_at,updated_at,customers(name,email),job_sites(name,city,state),users(full_name,email)"
            },
            {
              "name": "organization_id",
              "value": "={{'eq.' + $env.QUOTEBASE_ORGANIZATION_ID}}"
            },
            {
              "name": "is_active",
              "value": "eq.true"
            },
            {
              "name": "status",
              "value": "eq.pending_approval"
            },
            {
              "name": "order",
              "value": "created_at.asc"
            },
            {
              "name": "limit",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-pending-quotes",
      "name": "Fetch Pending Quotes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.sentKeys ??= {};\n\nconst rows = $input.all().flatMap((item) => {\n  if (Array.isArray(item.json)) return item.json;\n  if (Array.isArray(item.json.body)) return item.json.body;\n  return [item.json];\n}).filter((row) => row && row.id);\n\nconst fresh = [];\nfor (const row of rows) {\n  const key = `pending_approval:${row.id}:${row.status}`;\n  if (staticData.sentKeys[key]) continue;\n  staticData.sentKeys[key] = new Date().toISOString();\n  fresh.push({ json: row });\n}\n\nreturn fresh;"
      },
      "id": "dedupe-pending-quotes",
      "name": "Dedupe Pending Quotes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": `Quote ${$json.quote_number} is pending approval`,\n  \"blocks\": [\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": `*Quote ${$json.quote_number} needs approval*\\nCustomer: ${$json.customers?.name ?? 'Unknown'}\\nJob site: ${$json.job_sites?.name ?? 'Unknown'}\\nTotal: $${Number($json.total ?? 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`\n      }\n    },\n    {\n      \"type\": \"actions\",\n      \"elements\": [\n        {\n          \"type\": \"button\",\n          \"text\": { \"type\": \"plain_text\", \"text\": \"Open quote\" },\n          \"url\": `${$env.QUOTEBASE_APP_URL}/quotes/${$json.id}`\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "send-slack-approval-alert",
      "name": "Send Slack Approval Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        40
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Fetch Pending Quotes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Pending Quotes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pending Quotes": {
      "main": [
        [
          {
            "node": "Dedupe Pending Quotes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dedupe Pending Quotes": {
      "main": [
        [
          {
            "node": "Send Slack Approval Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}
